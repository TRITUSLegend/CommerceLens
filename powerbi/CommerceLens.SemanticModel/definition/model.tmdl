model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

ref table _Measures
ref table fact_orders
ref table fact_order_items
ref table dim_customer
ref table dim_product
ref table dim_seller
ref table dim_state
ref table dim_date
ref table recon_sql
ref table recon_seller_state
ref table model_metrics
ref table model_capture_curve
ref table shap_importance
ref table shap_state_effect
ref table model_curves
ref table model_target_comparison
ref table 'Late Cut'
ref table 'Flag %'
